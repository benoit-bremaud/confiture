# Optional: copy to .env (gitignored) next to compose.yaml to change a default.
# Voice downloaded into data/ on first start.
PIPER_VOICE=fr_FR-siwis-medium
# Owner of data/; Piper runs as this uid:gid.
PIPER_UID=1000
PIPER_GID=1000
# Speech-to-text backend (ADR-0008): sherpa = Parakeet TDT v3; add STT_STREAMING=1 for Kroko.
STT_LIBRARY=sherpa
STT_STREAMING=0
# Required: a locally administered MAC (first byte 02) the satellite keeps in Home Assistant.
SATELLITE_MAC=<locally-administered-mac, first byte 02>
# Required: Home Assistant long-lived token named confiture-nest-relay (Profile > Security).
NEST_RELAY_HA_TOKEN=<home-assistant-long-lived-token>
