# Copy to .env (gitignored) and fill in real values. Never commit .env.
# LLM host running Ollama (ADR-0004).
OLLAMA_URL=http://<probook-ip>:11434
# Home Assistant on the Pi 5, reached over Tailscale from outside the LAN.
HA_URL=http://<pi5-tailscale-ip>:8123
# SSH user on the home nodes.
NODE_USER=<user>
